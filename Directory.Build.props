<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!--
      Versioning: bump VersionPrefix (SemVer) in this file when releasing and record the change in
      CHANGELOG.md. CI passes BuildNumber (GitHub Actions run number); local builds use 0.
      Result: hwsuite 0.2.0, file version 0.2.0.<build>, informational 0.2.0+build.<build>.<commit>.
    -->
    <VersionPrefix>0.4.0</VersionPrefix>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).$(BuildNumber)</FileVersion>
    <InformationalVersion>$(VersionPrefix)+build.$(BuildNumber)</InformationalVersion>
    <Authors>HWSuite contributors</Authors>
    <Product>HWSuite</Product>
    <Copyright>HWSuite contributors</Copyright>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/aprodrigues31/HWSuite</RepositoryUrl>
    <!-- Localized user-facing strings live in HWSuite.Core/Localization; CA1303 does not apply. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>
</Project>
