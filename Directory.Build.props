<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Version>0.1.0</Version>
    <Authors>HWSuite contributors</Authors>
    <Product>HWSuite</Product>
    <Copyright>HWSuite contributors</Copyright>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/aprodrigues31/HWSuite</RepositoryUrl>
    <!-- Localized user-facing strings live in HWSuite.Core/Localization; CA1303 does not apply. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>
</Project>
