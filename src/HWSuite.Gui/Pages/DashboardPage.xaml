<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud"
    NavigationCacheMode="Required">
    <ScrollViewer x:Name="Scroller">
        <!-- Zoom scales the whole dashboard up on large screens (2K, 4K); the code sets Body.Width. -->
        <Viewbox x:Name="Zoom" Stretch="Uniform" VerticalAlignment="Top">
        <StackPanel x:Name="Body" Padding="28,6,28,20" Spacing="14">

            <!-- Header: what machine, how long it has been up, overall state -->
            <Grid ColumnSpacing="16" Padding="0,0,0,14" BorderBrush="{ThemeResource HudAccentDimBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="HeaderTag" Style="{StaticResource HudTagStyle}" />
                    <TextBlock x:Name="BoardName" Style="{StaticResource HudPageTitleStyle}" />
                    <TextBlock x:Name="MachineText" Style="{StaticResource HudMonoStyle}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="UptimeLabel" Style="{StaticResource HudTagStyle}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="UptimeText" Style="{StaticResource HudMonoStyle}" FontSize="15" Foreground="{ThemeResource HudTextBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="IntervalLabel" Style="{StaticResource HudTagStyle}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="IntervalText" Style="{StaticResource HudMonoStyle}" FontSize="15" Foreground="{ThemeResource HudTextBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Border x:Name="StatusChip" BorderThickness="1" Padding="14,8" VerticalAlignment="Center" BorderBrush="{ThemeResource HudAccentBrush}" Background="{ThemeResource HudAccentFaintBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle x:Name="StatusDot" Width="8" Height="8" Fill="{ThemeResource HudAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" FontFamily="{StaticResource HudMonoFont}" FontSize="12" CharacterSpacing="160" Foreground="{ThemeResource HudAccentBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="AltBody" HorizontalContentAlignment="Stretch" Visibility="Collapsed" />

            <StackPanel x:Name="HudBody" Spacing="14">
            <!-- Processor | graphics card: same layout, three dials each -->
            <Grid x:Name="TopRow" ColumnSpacing="14" hud:Responsive.MinColumn="520">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <hud:HudPanel Highlight="True">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="CpuTag" Style="{StaticResource HudTagStyle}" />
                        <TextBlock x:Name="CpuName" Style="{StaticResource HudNameStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
                        <Grid x:Name="CpuDials" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <hud:RingGauge x:Name="CpuLoadRing" Diameter="150" HorizontalAlignment="Center" />
                            <hud:RingGauge x:Name="CpuRing" Diameter="150" HorizontalAlignment="Center" Grid.Column="1" />
                            <hud:RingGauge x:Name="CpuClockRing" Diameter="150" HorizontalAlignment="Center" Grid.Column="2" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="PowerLabel" Style="{StaticResource HudTagStyle}" />
                                <hud:GlowText x:Name="PowerValue" />
                                <TextBlock x:Name="PowerUnit" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                            </StackPanel>
                            <StackPanel Spacing="3" Grid.Column="1">
                                <TextBlock x:Name="VoltLabel" Style="{StaticResource HudTagStyle}" />
                                <hud:GlowText x:Name="VoltValue" />
                                <TextBlock x:Name="VoltUnit" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                            </StackPanel>
                            <StackPanel Spacing="3" Grid.Column="2">
                                <TextBlock x:Name="ClockLabel" Style="{StaticResource HudTagStyle}" />
                                <hud:GlowText x:Name="ClockValue" />
                                <TextBlock x:Name="ClockUnit" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock x:Name="ThreadsLabel" Style="{StaticResource HudTagStyle}" />
                                <TextBlock x:Name="ThreadsCount" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <hud:ColumnBars x:Name="ThreadBars" Height="38" />
                        </StackPanel>
                    </StackPanel>
                </hud:HudPanel>
                <hud:HudPanel Grid.Column="1">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock x:Name="GpuTag" Style="{StaticResource HudTagStyle}" />
                            <TextBlock x:Name="GpuTemps" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="GpuName" Style="{StaticResource HudNameStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
                        <Grid x:Name="GpuDials" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <hud:RingGauge x:Name="GpuLoadRing" Diameter="150" HorizontalAlignment="Center" />
                            <hud:RingGauge x:Name="GpuTempRing" Diameter="150" HorizontalAlignment="Center" Grid.Column="1" />
                            <hud:RingGauge x:Name="GpuClockRing" Diameter="150" HorizontalAlignment="Center" Grid.Column="2" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="GpuPowerLabel" Style="{StaticResource HudTagStyle}" />
                                <hud:GlowText x:Name="GpuPowerValue" />
                                <TextBlock x:Name="GpuPowerUnit" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                            </StackPanel>
                            <StackPanel Spacing="3" Grid.Column="1">
                                <TextBlock x:Name="GpuFanLabel" Style="{StaticResource HudTagStyle}" />
                                <hud:GlowText x:Name="GpuFanValue" />
                                <TextBlock x:Name="GpuFanUnit" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                            </StackPanel>
                            <StackPanel Spacing="3" Grid.Column="2">
                                <TextBlock x:Name="GpuMemLabel" Style="{StaticResource HudTagStyle}" />
                                <hud:GlowText x:Name="GpuMemValue" />
                                <TextBlock x:Name="GpuMemUnit" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock x:Name="GpuVramLabel" Text="VRAM" Style="{StaticResource HudTagStyle}" />
                                <TextBlock x:Name="GpuVramText" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <hud:SegmentBar x:Name="GpuBar" Height="10" Margin="0,14,0,14" />
                        </StackPanel>
                    </StackPanel>
                </hud:HudPanel>
            </Grid>

            <!-- Temperature history | network (these two stretch to fill the window) -->
            <Grid x:Name="MidRow" ColumnSpacing="14" hud:Responsive.MinColumn="520">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <hud:HudPanel>
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock x:Name="ChartTag" Style="{StaticResource HudTagStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="14" Height="2" Fill="{ThemeResource HudAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="CPU" Style="{StaticResource HudMonoStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="14" Height="2" Fill="{ThemeResource HudWarnBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="GPU" Style="{StaticResource HudMonoStyle}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <hud:LineChart x:Name="TempChart" Height="186" Unit="°" />
                    </StackPanel>
                </hud:HudPanel>
                <ContentControl x:Name="NetSlot" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>

            <!-- Memory | drives | cooling and power supply, three equal columns -->
            <Grid x:Name="BottomRow" ColumnSpacing="14" hud:Responsive.MinColumn="320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <hud:HudPanel>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="MemTag" Style="{StaticResource HudTagStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MemLabel" Style="{StaticResource HudMonoStyle}" FontSize="13" Foreground="{ThemeResource HudAccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            <hud:GlowText x:Name="MemUsed" Grid.Column="1" />
                            <TextBlock x:Name="MemPercent" Grid.Column="2" Style="{StaticResource HudMonoStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <hud:SegmentBar x:Name="MemBar" Height="10" />
                        <Grid>
                            <TextBlock x:Name="MemFree" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                            <TextBlock x:Name="MemNote" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource HudPanelStrokeBrush}" Opacity="0.5" Margin="0,4" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VramLabel" Style="{StaticResource HudMonoStyle}" FontSize="13" Foreground="{ThemeResource HudAccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            <hud:GlowText x:Name="VramUsed" Grid.Column="1" />
                            <TextBlock x:Name="VramPercent" Grid.Column="2" Style="{StaticResource HudMonoStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <hud:SegmentBar x:Name="VramBar" Height="10" />
                        <Grid>
                            <TextBlock x:Name="VramFree" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                            <TextBlock x:Name="VramNote" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </Grid>
                    </StackPanel>
                </hud:HudPanel>
                <hud:HudPanel x:Name="StoragePanel" Grid.Column="1">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="StorageTag" Style="{StaticResource HudTagStyle}" />
                        <Grid x:Name="DriveGrid" ColumnSpacing="28" RowSpacing="16" />
                    </StackPanel>
                </hud:HudPanel>
                <hud:HudPanel Grid.Column="2">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="CoolingTag" Style="{StaticResource HudTagStyle}" Margin="0,0,0,6" />
                        <StackPanel x:Name="CoolingList" />
                    </StackPanel>
                </hud:HudPanel>
            </Grid>
            </StackPanel>

            <ContentControl x:Name="NetBody" HorizontalContentAlignment="Stretch" />
        </StackPanel>
        </Viewbox>
    </ScrollViewer>
</Page>
