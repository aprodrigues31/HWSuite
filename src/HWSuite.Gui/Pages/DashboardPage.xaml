<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Padding="28,6,28,28" Spacing="16">

            <!-- Header: what machine, how long it has been up, overall state -->
            <Grid ColumnSpacing="16" Padding="0,0,0,14" BorderBrush="{ThemeResource HudAccentDimBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="HeaderTag" Style="{StaticResource HudTagStyle}" />
                    <TextBlock x:Name="BoardName" Style="{StaticResource HudPageTitleStyle}" />
                    <TextBlock x:Name="MachineText" Style="{StaticResource HudMonoStyle}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="UptimeLabel" Style="{StaticResource HudTagStyle}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="UptimeText" Style="{StaticResource HudMonoStyle}" FontSize="15" Foreground="{ThemeResource HudTextBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="IntervalLabel" Style="{StaticResource HudTagStyle}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="IntervalText" Style="{StaticResource HudMonoStyle}" FontSize="15" Foreground="{ThemeResource HudTextBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Border x:Name="StatusChip" BorderThickness="1" Padding="14,8" VerticalAlignment="Center" BorderBrush="{ThemeResource HudAccentBrush}" Background="{ThemeResource HudAccentFaintBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle x:Name="StatusDot" Width="8" Height="8" Fill="{ThemeResource HudAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" FontFamily="{StaticResource HudMonoFont}" FontSize="12" CharacterSpacing="160" Foreground="{ThemeResource HudAccentBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Processor (the "reactor") | graphics card + memory -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <hud:HudPanel Highlight="True" Padding="22,20,24,20">
                    <Grid ColumnSpacing="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <hud:RingGauge x:Name="CpuRing" Diameter="232" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                            <TextBlock x:Name="CpuTag" Style="{StaticResource HudTagStyle}" />
                            <TextBlock x:Name="CpuName" Style="{StaticResource HudNameStyle}" FontSize="24" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="ClockLabel" Style="{StaticResource HudTagStyle}" />
                                    <hud:GlowText x:Name="ClockValue" />
                                    <TextBlock x:Name="ClockUnit" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock x:Name="PowerLabel" Style="{StaticResource HudTagStyle}" />
                                    <hud:GlowText x:Name="PowerValue" />
                                    <TextBlock x:Name="PowerUnit" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock x:Name="VoltLabel" Style="{StaticResource HudTagStyle}" />
                                    <hud:GlowText x:Name="VoltValue" />
                                    <TextBlock x:Name="VoltUnit" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock x:Name="ThreadsLabel" Style="{StaticResource HudTagStyle}" />
                                    <TextBlock x:Name="ThreadsCount" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <hud:ColumnBars x:Name="ThreadBars" Height="38" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </hud:HudPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <hud:HudPanel>
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock x:Name="GpuTag" Style="{StaticResource HudTagStyle}" />
                                <TextBlock x:Name="GpuTemps" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="GpuName" Style="{StaticResource HudNameStyle}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <hud:GlowText x:Name="GpuClock" />
                                <TextBlock x:Name="GpuPower" Grid.Column="1" Style="{StaticResource HudMonoStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <hud:SegmentBar x:Name="GpuBar" Height="10" />
                            <Grid>
                                <TextBlock x:Name="GpuLoad" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                                <TextBlock x:Name="GpuVram" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </hud:HudPanel>
                    <hud:HudPanel>
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="MemTag" Style="{StaticResource HudTagStyle}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <hud:GlowText x:Name="MemUsed" />
                                <TextBlock x:Name="MemPercent" Grid.Column="1" Style="{StaticResource HudMonoStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <hud:SegmentBar x:Name="MemBar" Height="10" />
                            <TextBlock x:Name="MemFree" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" />
                        </StackPanel>
                    </hud:HudPanel>
                </StackPanel>
            </Grid>

            <!-- Temperature history | cooling and power supply -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>
                <hud:HudPanel>
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock x:Name="ChartTag" Style="{StaticResource HudTagStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="14" Height="2" Fill="{ThemeResource HudAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="CPU" Style="{StaticResource HudMonoStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="14" Height="2" Fill="{ThemeResource HudWarnBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="GPU" Style="{StaticResource HudMonoStyle}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <hud:LineChart x:Name="TempChart" Height="186" Unit="°" />
                    </StackPanel>
                </hud:HudPanel>
                <hud:HudPanel Grid.Column="1">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="CoolingTag" Style="{StaticResource HudTagStyle}" Margin="0,0,0,6" />
                        <StackPanel x:Name="CoolingList" />
                    </StackPanel>
                </hud:HudPanel>
            </Grid>

            <!-- Drives -->
            <hud:HudPanel>
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StorageTag" Style="{StaticResource HudTagStyle}" />
                    <Grid x:Name="DriveGrid" ColumnSpacing="28" RowSpacing="16" />
                </StackPanel>
            </hud:HudPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
