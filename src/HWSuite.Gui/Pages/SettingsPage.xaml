<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="20,12,20,24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock x:Name="PageTitle" Style="{StaticResource HudPageTitleStyle}" />

            <TextBlock x:Name="GeneralTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <NumberBox
                        x:Name="IntervalBox"
                        HorizontalAlignment="Left"
                        MinWidth="240"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="IntervalBox_ValueChanged" />
                    <StackPanel Spacing="4">
                        <ComboBox x:Name="LanguageBox" MinWidth="220" SelectionChanged="LanguageBox_SelectionChanged" />
                        <TextBlock x:Name="LanguageHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <RadioButtons x:Name="ThemeChoice" SelectionChanged="ThemeChoice_SelectionChanged" />
                    <ToggleSwitch x:Name="CloseToTraySwitch" Toggled="CloseToTraySwitch_Toggled" />
                    <StackPanel Spacing="6">
                        <ToggleSwitch x:Name="UpdatesSwitch" Toggled="UpdatesSwitch_Toggled" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="CheckUpdatesButton" Click="CheckUpdatesButton_Click" />
                            <TextBlock x:Name="CheckUpdatesText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="StartupSwitch" Toggled="StartupSwitch_Toggled" />
                        <TextBlock x:Name="StartupHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="AlertsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="AlertsSwitch" Toggled="AlertsSwitch_Toggled" />
                    <TextBlock x:Name="AlertsHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel x:Name="RulesPanel" Spacing="8" />
                    <Button x:Name="RestoreButton" Click="RestoreButton_Click" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="PsuTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="PsuSwitch" Toggled="PsuSwitch_Toggled" />
                        <TextBlock x:Name="PsuHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="PumpBox" MinWidth="320" SelectionChanged="PumpBox_SelectionChanged" />
                        <NumberBox x:Name="PumpMinBox" Minimum="100" Maximum="5000" SmallChange="50" LargeChange="100"
                                   SpinButtonPlacementMode="Compact" ValueChanged="PumpMinBox_ValueChanged" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="PumpHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="FilesTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ReportsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ReportsFolderText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ReportsBrowseButton" Click="ReportsBrowseButton_Click" />
                            <Button x:Name="ReportsResetButton" Click="ReportsResetButton_Click" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LogoLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LogoFileText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="LogoBrowseButton" Click="LogoBrowseButton_Click" />
                            <Button x:Name="LogoNoneButton" Click="LogoNoneButton_Click" />
                            <Button x:Name="LogoResetButton" Click="LogoResetButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="LogTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <ToggleSwitch x:Name="LogSwitch" Toggled="LogSwitch_Toggled" />
                    <TextBlock x:Name="LogFolderText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ChangeLogFolderButton" Click="ChangeLogFolderButton_Click" />
                        <Button x:Name="DefaultLogFolderButton" Click="DefaultLogFolderButton_Click" />
                        <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
