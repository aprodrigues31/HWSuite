<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="20,12,20,16" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="ProcessorText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="StartButton" Click="StartButton_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
                <ComboBox x:Name="DurationBox" MinWidth="120" />
            </StackPanel>

            <StackPanel Spacing="4">
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0" />
                <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="16,12" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SingleLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SingleValue" Style="{StaticResource TitleLargeTextBlockStyle}" Text="—" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16,12" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="MultiLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="MultiValue" Style="{StaticResource TitleLargeTextBlockStyle}" Text="—" />
                        <TextBlock x:Name="ScalingText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="NoteText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <TextBlock x:Name="HistoryTitle" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <StackPanel x:Name="HistoryList" Spacing="2" />
        </StackPanel>
    </ScrollViewer>
</Page>
