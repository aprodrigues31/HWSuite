<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="20,12,20,16" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="AboutText" TextWrapping="Wrap" />
        <HyperlinkButton x:Name="RepoLink" NavigateUri="https://github.com/aprodrigues31/HWSuite" Content="github.com/aprodrigues31/HWSuite" />
    </StackPanel>
</Page>
