<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud">
    <StackPanel Padding="28,6,28,16" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock x:Name="PageTitle" Style="{StaticResource HudPageTitleStyle}" />
        <hud:HudPanel Highlight="True" Padding="28,24,28,24">
            <Grid ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Viewbox Width="96" Height="96" VerticalAlignment="Top">
                    <Canvas Width="34" Height="34">
                        <Path Data="M17,2 L30,9.5 L30,24.5 L17,32 L4,24.5 L4,9.5 Z" Stroke="{ThemeResource HudAccentBrush}" StrokeThickness="1.2" />
                        <Path Data="M17,6 L26.5,11.5 L26.5,22.5 L17,28 L7.5,22.5 L7.5,11.5 Z" Stroke="{ThemeResource HudAccentDimBrush}" StrokeThickness="0.8" />
                        <Path Data="M10,20 L14,15 L17,18 L23,11" Stroke="{ThemeResource HudAccentBrush}" StrokeThickness="1.6" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="HWSUITE" FontFamily="{StaticResource HudBoldFont}" FontSize="34" CharacterSpacing="300" Foreground="{ThemeResource HudTextBrush}" />
                    <TextBlock x:Name="VersionTag" Style="{StaticResource HudTagStyle}" Foreground="{ThemeResource HudAccentBrush}" />
                    <TextBlock x:Name="AboutText" TextWrapping="Wrap" Foreground="{ThemeResource HudTextDimBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                        <Button x:Name="CheckButton" Click="CheckButton_Click" />
                        <ProgressRing x:Name="Checking" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateText" TextWrapping="Wrap" Style="{StaticResource HudMonoStyle}" />
                    <HyperlinkButton x:Name="RepoLink" Padding="0" NavigateUri="https://github.com/aprodrigues31/HWSuite" Content="github.com/aprodrigues31/HWSuite" FontFamily="{StaticResource HudMonoFont}" />
                </StackPanel>
            </Grid>
        </hud:HudPanel>
        <TextBlock x:Name="FontsText" Style="{StaticResource HudMonoStyle}" FontSize="12" Foreground="{ThemeResource HudTagBrush}" TextWrapping="Wrap" />
    </StackPanel>
</Page>
