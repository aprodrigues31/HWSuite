<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.SensorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud"
    NavigationCacheMode="Required">
    <Grid Padding="28,6,28,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, channel count, search -->
        <Grid ColumnSpacing="16" Padding="0,0,0,12" BorderBrush="{ThemeResource HudAccentDimBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="HeaderTag" Style="{StaticResource HudTagStyle}" />
                <TextBlock x:Name="PageTitle" Style="{StaticResource HudPageTitleStyle}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource HudMonoStyle}" FontSize="12" />
                <InfoBar x:Name="HintBar" IsClosable="True" IsOpen="False" Severity="Warning" />
                <InfoBar x:Name="AlertBar" IsClosable="True" IsOpen="False" Severity="Success" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" Width="240" VerticalAlignment="Bottom" TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- Summary -->
        <Grid x:Name="SummaryGrid" Grid.Row="1" ColumnSpacing="12" />

        <!-- Filters: which components (several at once) and which kind of reading -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <Grid ColumnSpacing="14" RowSpacing="8" Padding="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CategoryLabel" Style="{StaticResource HudTagStyle}" VerticalAlignment="Center" />
                <StackPanel x:Name="CategoryFilters" Grid.Column="1" Orientation="Horizontal" Spacing="8" />
                <TextBlock x:Name="KindLabel" Grid.Row="1" Style="{StaticResource HudTagStyle}" VerticalAlignment="Center" />
                <StackPanel x:Name="Filters" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" />
            </Grid>
        </ScrollViewer>

        <!-- Devices, in two columns -->
        <ScrollViewer Grid.Row="3" Padding="0,0,8,0">
            <!-- As many columns as fit (each at least 520 px); filtering re-flows the panels. -->
            <hud:MasonryPanel x:Name="DeviceGrid" MinColumnWidth="520" Spacing="16" />
        </ScrollViewer>

        <!-- History of the selected sensor -->
        <hud:HudPanel Grid.Row="4" Padding="20,12,20,12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ChartTitle" Style="{StaticResource HudTagStyle}" VerticalAlignment="Center" />
                    <Button x:Name="AlertButton" Grid.Column="1" Click="AlertButton_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                            <TextBlock x:Name="AlertButtonText" />
                        </StackPanel>
                    </Button>
                </Grid>
                <hud:LineChart x:Name="Chart" Grid.Row="1" Height="130" />
            </Grid>
        </hud:HudPanel>
    </Grid>
</Page>
