<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.TuneupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Padding="28,6,28,24" Spacing="16">
            <StackPanel Spacing="4" Padding="0,0,0,12" BorderBrush="{ThemeResource HudAccentDimBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="HeaderTag" Style="{StaticResource HudTagStyle}" />
                <TextBlock x:Name="PageTitle" Style="{StaticResource HudPageTitleStyle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource HudMonoStyle}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="AdminBar" IsClosable="False" Severity="Warning" />

            <!-- The tasks: blocks that re-flow with the window -->
            <hud:MasonryPanel x:Name="Tasks" MinColumnWidth="420" Spacing="16" />

            <hud:HudPanel Highlight="True">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="RunButton" Style="{StaticResource HudAccentButtonStyle}" Click="RunButton_Click" />
                        <Button x:Name="StopButton" MinHeight="44" Click="StopButton_Click" IsEnabled="False" />
                    </StackPanel>
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource HudMonoStyle}" FontSize="13" TextWrapping="Wrap" />
                    <StackPanel x:Name="Results" Spacing="8" />
                </StackPanel>
            </hud:HudPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
