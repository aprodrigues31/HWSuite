<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.ChartsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Padding="20,12,20,24" Spacing="14">
            <!-- Header: title and what is being recorded -->
            <StackPanel Spacing="4" Padding="0,0,0,12" BorderBrush="{ThemeResource HudAccentDimBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="HeaderTag" Style="{StaticResource HudTagStyle}" />
                <TextBlock x:Name="PageTitle" Style="{StaticResource HudPageTitleStyle}" />
                <TextBlock x:Name="RecordText" Style="{StaticResource HudMonoStyle}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>

            <!-- Source (live or a recorded log), time window, recording -->
            <hud:WrapPanel Spacing="8" LineSpacing="8">
                <ComboBox x:Name="SourceBox" MinWidth="260" SelectionChanged="SourceBox_SelectionChanged" />
                <ComboBox x:Name="WindowBox" MinWidth="110" SelectionChanged="WindowBox_SelectionChanged" />
                <ToggleButton x:Name="RecordButton" MinHeight="32" Click="RecordButton_Click" />
                <Button x:Name="LogFolderButton" MinHeight="32" Click="LogFolderButton_Click" />
                <Button x:Name="FolderButton" MinHeight="32" Click="FolderButton_Click" />
            </hud:WrapPanel>

            <!-- Filters, as on Sensors: component, reading type, search -->
            <Grid ColumnSpacing="14" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CategoryLabel" Style="{StaticResource HudTagStyle}" VerticalAlignment="Center" />
                <hud:WrapPanel x:Name="CategoryFilters" Grid.Column="1" />
                <TextBox x:Name="SearchBox" Grid.Column="2" Width="220" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="KindLabel" Grid.Row="1" Style="{StaticResource HudTagStyle}" VerticalAlignment="Center" />
                <hud:WrapPanel x:Name="KindFilters" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" />
            </Grid>

            <!-- Sensors as chips: click to add to / remove from the charts -->
            <hud:HudPanel>
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock x:Name="PickerTag" Style="{StaticResource HudTagStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <TextBlock x:Name="SelectedText" Style="{StaticResource HudMonoStyle}" FontSize="12" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="ClearButton" Padding="4,2" Click="ClearButton_Click" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <hud:WrapPanel x:Name="SensorChips" Spacing="6" LineSpacing="6" />
                    </ScrollViewer>
                    <TextBlock x:Name="MoreText" Style="{StaticResource HudMonoStyle}" FontSize="12" Visibility="Collapsed" />
                </StackPanel>
            </hud:HudPanel>

            <TextBlock x:Name="EmptyText" Style="{StaticResource HudMonoStyle}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />
            <!-- One chart per unit, as many columns as fit -->
            <hud:MasonryPanel x:Name="ChartsHost" MinColumnWidth="560" Spacing="16" />
        </StackPanel>
    </ScrollViewer>
</Page>
