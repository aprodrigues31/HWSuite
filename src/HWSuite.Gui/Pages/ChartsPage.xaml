<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.ChartsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Padding="28,6,28,24" Spacing="16">
            <StackPanel Spacing="4" Padding="0,0,0,12" BorderBrush="{ThemeResource HudAccentDimBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="HeaderTag" Style="{StaticResource HudTagStyle}" />
                <TextBlock x:Name="PageTitle" Style="{StaticResource HudPageTitleStyle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource HudMonoStyle}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Source, window, recording -->
            <hud:HudPanel>
                <Grid ColumnSpacing="14" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SourceBox" MinWidth="300" SelectionChanged="SourceBox_SelectionChanged" />
                    <ComboBox x:Name="WindowBox" Grid.Column="1" MinWidth="150" SelectionChanged="WindowBox_SelectionChanged" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                        <ToggleButton x:Name="RecordButton" MinHeight="34" Click="RecordButton_Click" />
                        <Button x:Name="FolderButton" MinHeight="34" Click="FolderButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="RecordText" Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource HudMonoStyle}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Grid>
            </hud:HudPanel>

            <Grid x:Name="Layout" ColumnSpacing="16" RowSpacing="16" SizeChanged="Layout_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PickerColumn" Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sensor picker -->
                <hud:HudPanel x:Name="PickerPanel" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="PickerTag" Style="{StaticResource HudTagStyle}" />
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
                        <Grid>
                            <TextBlock x:Name="SelectedText" Style="{StaticResource HudMonoStyle}" FontSize="12" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="ClearButton" HorizontalAlignment="Right" Padding="4,2" Click="ClearButton_Click" />
                        </Grid>
                        <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SensorList" Spacing="2" />
                        </ScrollViewer>
                    </StackPanel>
                </hud:HudPanel>

                <!-- One chart per unit -->
                <StackPanel x:Name="ChartsColumn" Grid.Column="1" Spacing="16">
                    <TextBlock x:Name="EmptyText" Style="{StaticResource HudMonoStyle}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />
                    <StackPanel x:Name="ChartsHost" Spacing="16" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
