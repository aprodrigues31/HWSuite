<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud">
    <Grid Padding="20,12,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, machine, search, export -->
        <Grid ColumnSpacing="12" Padding="0,0,0,12" BorderBrush="{ThemeResource HudAccentDimBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitle" Style="{StaticResource HudPageTitleStyle}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource HudMonoStyle}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <TextBox x:Name="SearchBox" Width="240" TextChanged="SearchBox_TextChanged" />
                <Button x:Name="SaveVbiosButton" Click="SaveVbiosButton_Click" Visibility="Collapsed" />
                <Button x:Name="SaveButton" Click="SaveButton_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Components: several at once, or all -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="14" Padding="0,0,0,4">
                <TextBlock x:Name="CategoryLabel" Style="{StaticResource HudTagStyle}" VerticalAlignment="Center" />
                <StackPanel x:Name="CategoryFilters" Orientation="Horizontal" Spacing="8" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="2" Padding="0,0,8,0">
            <StackPanel Padding="0,0,4,12" Spacing="12">
                <TextBlock x:Name="EmptyText" Style="{StaticResource HudMonoStyle}" FontSize="13" Visibility="Collapsed" />
                <!-- As many columns as fit; filtering re-flows the blocks. -->
                <hud:MasonryPanel x:Name="Sections" MinColumnWidth="560" Spacing="16" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
