<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HWSuite.Gui.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud">
    <ScrollViewer>
        <StackPanel Padding="28,6,28,24" Spacing="16">
            <StackPanel Spacing="4" Padding="0,0,0,12" BorderBrush="{ThemeResource HudAccentDimBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="HeaderTag" Style="{StaticResource HudTagStyle}" />
                <TextBlock x:Name="PageTitle" Style="{StaticResource HudPageTitleStyle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource HudMonoStyle}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="460" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RefreshButton" Style="{StaticResource HudAccentButtonStyle}" Click="RefreshButton_Click" />
                <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="CountText" Grid.Column="2" Style="{StaticResource HudMonoStyle}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <hud:HudPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ImpactTag" Style="{StaticResource HudTagStyle}" />
                    <TextBlock x:Name="BootText" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock x:Name="MeasureText" Style="{StaticResource HudMonoStyle}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource HudTagBrush}" />
                </StackPanel>
            </hud:HudPanel>

            <InfoBar x:Name="AdminBar" Severity="Informational" IsClosable="False" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" />

            <hud:HudPanel Highlight="True">
                <StackPanel>
                    <StackPanel x:Name="Rows" />
                    <TextBlock x:Name="EmptyText" Margin="0,12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </StackPanel>
            </hud:HudPanel>

            <TextBlock x:Name="NoteText" Style="{StaticResource HudMonoStyle}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource HudTagBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
