<?xml version="1.0" encoding="utf-8"?>
<!--
    HUD look of HWSuite: near-black background with a faint grid, translucent panels with chamfered corners,
    one bright accent (cyan by default) for live values, amber for "attention", red for alerts.
    Fonts: Chakra Petch (titles and text) and JetBrains Mono (every number), both SIL OFL, in Assets\Fonts.
    The overrides below also restyle the standard WinUI controls (buttons, lists, dialogs) in the same palette.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Accent (replaced at start by the color chosen in Settings). -->
            <Color x:Key="SystemAccentColor">#FF4FE3FF</Color>
            <Color x:Key="SystemAccentColorLight1">#FF7FEBFF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF4FE3FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFA8F1FF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF2BB8D4</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1A8FA6</Color>
            <Color x:Key="SystemAccentColorDark3">#FF0F6678</Color>

            <SolidColorBrush x:Key="HudAccentBrush" Color="#FF4FE3FF" />
            <SolidColorBrush x:Key="HudAccentDimBrush" Color="#264FE3FF" />
            <SolidColorBrush x:Key="HudAccentFaintBrush" Color="#124FE3FF" />
            <SolidColorBrush x:Key="HudWarnBrush" Color="#FFFFB547" />
            <SolidColorBrush x:Key="HudWarnDimBrush" Color="#2EFFB547" />
            <SolidColorBrush x:Key="HudCritBrush" Color="#FFFF4F6E" />
            <SolidColorBrush x:Key="HudGoodBrush" Color="#FF39F5B0" />
            <SolidColorBrush x:Key="HudBackgroundBrush" Color="#FF04070B" />
            <SolidColorBrush x:Key="HudRailBrush" Color="#F203080D" />
            <SolidColorBrush x:Key="HudPanelBrush" Color="#E0081420" />
            <SolidColorBrush x:Key="HudPanelStrongBrush" Color="#F00A1826" />
            <SolidColorBrush x:Key="HudPanelStrokeBrush" Color="#3A4FE3FF" />
            <SolidColorBrush x:Key="HudGridLineBrush" Color="#0C4FE3FF" />
            <SolidColorBrush x:Key="HudTagBrush" Color="#FF6FA9BC" />
            <SolidColorBrush x:Key="HudTextBrush" Color="#FFE8F7FF" />
            <SolidColorBrush x:Key="HudTextDimBrush" Color="#FF9CC3D1" />
            <SolidColorBrush x:Key="HudHoverBrush" Color="#0F4FE3FF" />
            <SolidColorBrush x:Key="HudSelectedBrush" Color="#174FE3FF" />

            <!-- Standard WinUI brushes in the HUD palette. -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF04070B" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF07101A" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#B3070F17" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#E0081420" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#E00A1826" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3A4FE3FF" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#264FE3FF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0F4FE3FF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0A4FE3FF" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF0B1824" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF10202F" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF08131D" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF050C13" />
            <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#FF5E8C9C" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#404FE3FF" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#664FE3FF" />
            <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#404FE3FF" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE8F7FF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF9CC3D1" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF6FA9BC" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF031016" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFFB547" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFFF4F6E" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF39F5B0" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF4FE3FF" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#26FFB547" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#26FF4F6E" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#2639F5B0" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#1A4FE3FF" />
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#F7071019" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF07111A" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#664FE3FF" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FF0A1826" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FF07111A" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#664FE3FF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Fonts: each weight is its own file, so each gets its own family resource (with the legacy name as fallback). -->
    <FontFamily x:Key="HudBodyFont">ms-appx:///Assets/Fonts/ChakraPetch-Regular.ttf#Chakra Petch</FontFamily>
    <FontFamily x:Key="HudBodyMediumFont">ms-appx:///Assets/Fonts/ChakraPetch-Medium.ttf#Chakra Petch Medium, ms-appx:///Assets/Fonts/ChakraPetch-Medium.ttf#Chakra Petch</FontFamily>
    <FontFamily x:Key="HudDisplayFont">ms-appx:///Assets/Fonts/ChakraPetch-SemiBold.ttf#Chakra Petch SemiBold, ms-appx:///Assets/Fonts/ChakraPetch-SemiBold.ttf#Chakra Petch</FontFamily>
    <FontFamily x:Key="HudBoldFont">ms-appx:///Assets/Fonts/ChakraPetch-Bold.ttf#Chakra Petch</FontFamily>
    <FontFamily x:Key="HudMonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
    <FontFamily x:Key="HudMonoMediumFont">ms-appx:///Assets/Fonts/JetBrainsMono-Medium.ttf#JetBrains Mono Medium, ms-appx:///Assets/Fonts/JetBrainsMono-Medium.ttf#JetBrains Mono</FontFamily>
    <FontFamily x:Key="HudMonoStrongFont">ms-appx:///Assets/Fonts/JetBrainsMono-SemiBold.ttf#JetBrains Mono SemiBold, ms-appx:///Assets/Fonts/JetBrainsMono-SemiBold.ttf#JetBrains Mono</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/ChakraPetch-Regular.ttf#Chakra Petch</FontFamily>

    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>

    <!-- Text styles: the standard keys are redefined so existing pages pick up the HUD fonts. -->
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudDisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource HudTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudDisplayFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CharacterSpacing" Value="30" />
        <Setter Property="Foreground" Value="{ThemeResource HudTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudBodyMediumFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudBodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <!-- "// SECTION" labels above values. -->
    <Style x:Key="HudTagStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{ThemeResource HudTagBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="HudPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudDisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource HudTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="HudNameStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudDisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource HudTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="HudValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudMonoStrongFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{ThemeResource HudTextBrush}" />
    </Style>
    <Style x:Key="HudBigValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudMonoStrongFont}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource HudTextBrush}" />
    </Style>
    <Style x:Key="HudMonoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudMonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource HudTextDimBrush}" />
    </Style>

    <!-- Chamfered panel. -->
    <Style TargetType="hud:HudPanel">
        <Setter Property="Background" Value="{ThemeResource HudPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HudPanelStrokeBrush}" />
        <Setter Property="Padding" Value="20,16,20,16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hud:HudPanel">
                    <Grid>
                        <Path x:Name="PART_Shape" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                        <Path x:Name="PART_Corner" Stroke="{ThemeResource HudAccentBrush}" StrokeThickness="2" Opacity="0" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation rail item: icon over a short label; the accent bar and tint mark the current page. -->
    <Style x:Key="HudRailItemStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{ThemeResource HudTextDimBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="GroupName" Value="HudRail" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" MinHeight="64" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                        <Setter Target="Presenter.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Selected.Opacity" Value="1" />
                                        <Setter Target="Indicator.Opacity" Value="1" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource HudAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="Selected" Fill="{ThemeResource HudSelectedBrush}" Opacity="0" />
                        <Rectangle x:Name="Hover" Fill="{ThemeResource HudHoverBrush}" Opacity="0" />
                        <Rectangle x:Name="Indicator" Width="2" HorizontalAlignment="Left" Fill="{ThemeResource HudAccentBrush}" Opacity="0" />
                        <ContentPresenter
                            x:Name="Presenter"
                            Padding="4,10,4,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action ("START TEST"): accent fill, display font, wide tracking. -->
    <Style x:Key="HudAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource HudBoldFont}" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="26,8,26,8" />
    </Style>
</ResourceDictionary>
