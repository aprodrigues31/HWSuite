<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HWSuite.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hud="using:HWSuite.Gui.Hud">

    <Grid x:Name="Root" Background="{ThemeResource HudBackgroundBrush}" RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <hud:GridBackdrop Grid.ColumnSpan="2" />

        <!-- Navigation rail -->
        <Border Background="{ThemeResource HudRailBrush}" BorderBrush="{ThemeResource HudPanelStrokeBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox Width="36" Height="36" Margin="0,18,0,20">
                    <Canvas Width="34" Height="34">
                        <Path Data="M17,2 L30,9.5 L30,24.5 L17,32 L4,24.5 L4,9.5 Z" Stroke="{ThemeResource HudAccentBrush}" StrokeThickness="1.6" />
                        <Path Data="M10,20 L14,15 L17,18 L23,11" Stroke="{ThemeResource HudAccentBrush}" StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
                <StackPanel x:Name="RailTop" Grid.Row="1" Spacing="2" />
                <StackPanel x:Name="RailBottom" Grid.Row="2" Spacing="2" Margin="0,0,0,14" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar (the window's caption buttons sit at its right end). -->
            <Grid x:Name="TitleBar" Background="Transparent" Padding="20,0,150,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="HWSUITE" FontFamily="{StaticResource HudBoldFont}" FontSize="13" CharacterSpacing="300" Foreground="{ThemeResource HudTextBrush}" />
                    <TextBlock x:Name="TitleVersion" Style="{StaticResource HudTagStyle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleMode" Style="{StaticResource HudTagStyle}" Foreground="{ThemeResource HudWarnBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="AccessBar"
                Grid.Row="1"
                Margin="24,4,24,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Name="AccessButton" Click="AccessButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="UpdateBar"
                Grid.Row="2"
                Margin="24,4,24,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Name="UpdateButton" Click="UpdateButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Benchmark: tests | saved results -->
            <SelectorBar x:Name="BenchTabs" Grid.Row="3" Margin="20,0,20,0" Visibility="Collapsed" SelectionChanged="BenchTabs_SelectionChanged">
                <SelectorBarItem x:Name="BenchRunTab" Tag="bench" />
                <SelectorBarItem x:Name="BenchResultsTab" Tag="benchresults" />
            </SelectorBar>

            <Frame x:Name="ContentFrame" Grid.Row="4" FontFamily="{StaticResource HudBodyFont}" />
        </Grid>
    </Grid>
</Window>
